flowchart TD
    subgraph RAILS["Rails / PostgreSQL authority"]
        SETUP["Setup API + SensorZoneProvisioner\nZone package binding + four Nodes"]
        DB["Zones, Nodes, CropProfiles, lines, readings, events"]
        INGEST["SensorIngestor\nknown Node reconciliation"]
        CONFIG["ConfigPublishJob\nretained system + global actuator config"]
        MANUAL["Manual Node watering"]
    end

    subgraph SENSOR["Sensor Pico package"]
        USB["USB provisioning\nbackend-issued ch0..ch3"]
        STATE["Four sensor positions\nretained Node state"]
    end

    subgraph MQTT["Mosquitto"]
        NODE_STATE["Zone / Node state\nretained"]
        SYSTEM_CONFIG["system config\nretained"]
        ACT_CONFIG["global actuator topology\nretained"]
        ACT_CMD["Zone actuator command\nnon-retained"]
        ACT_STATUS["Zone actuator status\nnon-retained"]
    end

    subgraph PYTHON["Python automatic controller"]
        POLICY["Node crop + line-capacity\npolicy and safety"]
    end

    subgraph ACTUATOR["Dedicated production actuator"]
        ACT["One greenhouse-wide controller\nNode -> irrigation line"]
    end

    SETUP --> DB
    SETUP --> USB
    USB --> STATE
    STATE --> NODE_STATE
    NODE_STATE --> INGEST
    INGEST --> DB
    DB --> CONFIG
    CONFIG --> SYSTEM_CONFIG
    CONFIG --> ACT_CONFIG
    NODE_STATE --> POLICY
    SYSTEM_CONFIG --> POLICY
    POLICY --> ACT_CMD
    MANUAL --> ACT_CMD
    ACT_CONFIG --> ACT
    ACT_CMD --> ACT
    ACT --> ACT_STATUS
    ACT_STATUS --> DB
