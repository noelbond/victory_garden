erDiagram
    Zone {
        string zone_id PK
        string sensor_device_id UK "one sensor package"
        string name
        boolean active
        jsonb allowed_hours
    }

    Node {
        string node_id PK "stable package-ch0..ch3 identity"
        bigint zone_id FK "required"
        bigint crop_profile_id FK "optional during setup"
        string device_id "sensor package identity"
        string name "optional custom display name"
        int irrigation_line UK "global logical assignment"
        datetime last_seen_at "nil before telemetry"
        boolean active
    }

    CropProfile {
        string crop_id PK
        string crop_name
        decimal dry_threshold
        int max_pulse_runtime_sec
        int daily_max_runtime_sec
        boolean active
    }

    ConnectionSetting {
        bigint id PK
        int irrigation_line_count "installed physical capacity"
        string mqtt_host
        int mqtt_port
    }

    SensorReading {
        bigint id PK
        bigint zone_id FK
        string node_id
        datetime recorded_at
        int moisture_raw
        decimal moisture_percent
        string health
    }

    WateringEvent {
        bigint id PK
        bigint zone_id FK
        string node_id
        string command
        int runtime_seconds
        string idempotency_key UK
        string status
    }

    ActuatorStatus {
        bigint id PK
        bigint zone_id FK
        string node_id
        string state
        string idempotency_key
        string affected_run_idempotency_key
    }

    Zone        ||--o{ Node            : "one package; four provisioned Nodes"
    CropProfile o|--o{ Node            : "owned by Node"
    Zone        ||--o{ SensorReading   : "groups readings"
    Zone        ||--o{ WateringEvent   : "command identity"
    Zone        ||--o{ ActuatorStatus  : "status identity"
