stateDiagram-v2
    direction TB

    [*] --> ZoneCreated
    ZoneCreated --> TopologyEstablished : backend provisioning transaction
    TopologyEstablished : Zone package binding\nexactly Node ch0..ch3\nlast_seen_at may be nil
    TopologyEstablished --> HardwareProvisioned : USB applies issued identities\nand acknowledgement matches
    HardwareProvisioned --> TelemetryReconciled : first retained Node state
    TelemetryReconciled --> TelemetryReconciled : known Node updates telemetry only

    state "Node configuration" as CFG {
        [*] --> Pending
        Pending : retained configuration published
        Applied : sensor acknowledgement received
        Error : sensor config apply failed
        Pending --> Applied : config ACK = applied
        Pending --> Error : config ACK = error
        Error --> Pending : corrected config published
        Applied --> Pending : Node or Zone config changes
    }

    state "Watering eligibility" as WATER {
        [*] --> Ineligible
        Ineligible : crop missing, line missing,\nor line unsupported
        Eligible : active Node crop + supported logical line
        Ineligible --> Eligible : complete safe Node configuration
        Eligible --> Ineligible : crop/line/capacity becomes unsafe
    }

    TelemetryReconciled --> CFG
    CFG --> WATER
