classDiagram
    direction TB

    class Zone {
        +String zone_id
        +String sensor_device_id
        +String name
        +Boolean active
        +Hash allowed_hours
    }

    class Node {
        +String node_id
        +String device_id
        +String name
        +Integer irrigation_line
        +DateTime last_seen_at
        +display_name() String
        +irrigation_line_supported() Boolean
    }

    class CropProfile {
        +String crop_id
        +String crop_name
        +Decimal dry_threshold
        +Integer max_pulse_runtime_sec
        +Integer daily_max_runtime_sec
    }

    class SensorZoneProvisioner {
        +call(zone, sensor_device_id) Zone
        -validate_exact_four() Boolean
        -allocate_global_lines() Array
    }

    class SensorPackageZoneAssignment {
        +call(node, zone) Node
        -validate_package_zone() Boolean
    }

    class SensorIngestor {
        +call() SensorReading|nil
        -find_known_node() Node
        -update_telemetry() SensorReading
    }

    class ConfigPublishJob {
        +perform()
        -build_node_targets() Hash
        -build_actuator_topology() Hash
    }

    class PythonController {
        +consume_state()
        +evaluate_node_policy()
        +publish_automatic_command()
    }

    class DedicatedActuator {
        +apply_global_topology()
        +handle_zone_command()
        +enforce_safety()
    }

    Zone "1" --> "4" Node : provisioned sensor package
    Node --> "0..1" CropProfile : owns
    SensorZoneProvisioner ..> Zone : binds package
    SensorZoneProvisioner ..> Node : establishes topology
    SensorPackageZoneAssignment ..> Zone : preserves package invariant
    SensorIngestor ..> Node : reconciles
    ConfigPublishJob ..> PythonController : retained system config
    ConfigPublishJob ..> DedicatedActuator : retained global topology
    PythonController ..> DedicatedActuator : non-retained commands
