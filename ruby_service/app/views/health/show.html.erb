<div class="page-header">
  <div>
    <h1 class="page-title">System Health</h1>
    <div class="muted">Live operational view for nodes, readings, actuator state, config sync, and faults.</div>
  </div>
  <div>
    <span class="env-pill"><%= @environment_label %></span>
    <%= link_to "Zones", zones_path, class: "btn light" %>
  </div>
</div>

<div class="health-metrics">
  <div class="card metric-card">
    <div class="metric-label">Assigned Nodes</div>
    <div class="metric-value"><%= @summary[:assigned_nodes] %> / <%= @summary[:nodes] %></div>
    <div class="muted">assigned to a zone</div>
  </div>
  <div class="card metric-card <%= @summary[:stale_nodes] > 0 ? "metric-alert" : "metric-ok" %>">
    <div class="metric-label">Fresh Nodes</div>
    <div class="metric-value"><%= @summary[:nodes] - @summary[:stale_nodes] %> / <%= @summary[:nodes] %></div>
    <div class="muted">seen in the expected interval</div>
  </div>
  <div class="card metric-card <%= @summary[:fresh_zone_readings] < @summary[:assigned_zones] ? "metric-warn" : "metric-ok" %>">
    <div class="metric-label">Fresh Zone Readings</div>
    <div class="metric-value"><%= @summary[:fresh_zone_readings] %> / <%= @summary[:assigned_zones] %></div>
    <div class="muted">zones with a reading in the expected interval</div>
  </div>
  <div class="card metric-card <%= @summary[:config_pending] > 0 ? "metric-warn" : "metric-ok" %>">
    <div class="metric-label">Config Pending</div>
    <div class="metric-value"><%= @summary[:config_pending] %></div>
    <div class="muted">nodes waiting on config sync</div>
  </div>
  <div class="card metric-card <%= @summary[:config_errors] > 0 ? "metric-alert" : "metric-ok" %>">
    <div class="metric-label">Config Errors</div>
    <div class="metric-value"><%= @summary[:config_errors] %></div>
    <div class="muted">nodes with config failures</div>
  </div>
  <% firstboot_tone =
      case @summary[:firstboot_status]
      when "complete" then "metric-ok"
      when "failed" then "metric-alert"
      when "running" then "metric-warn"
      else ""
      end %>
  <div class="card metric-card <%= firstboot_tone %>">
    <div class="metric-label">Image Provisioning</div>
    <div class="metric-value"><%= @summary[:firstboot_status].to_s.humanize %></div>
    <div class="muted">
      <% if firstboot_status.complete? %>
        first boot finished
      <% elsif firstboot_status.failed? %>
        first boot needs review
      <% elsif firstboot_status.running? %>
        first boot is still running
      <% else %>
        not image-managed
      <% end %>
    </div>
  </div>
  <% mqtt_consumer_tone =
      case @summary[:mqtt_consumer_status]
      when "connected" then "metric-ok"
      when "retrying" then "metric-warn"
      when "degraded" then "metric-alert"
      else ""
      end %>
  <div class="card metric-card <%= mqtt_consumer_tone %>">
    <div class="metric-label">MQTT Consumer</div>
    <div class="metric-value"><%= @summary[:mqtt_consumer_status].to_s.humanize %></div>
    <div class="muted">
      <% if @mqtt_consumer_status["connected"] %>
        subscribed and receiving
      <% elsif @mqtt_consumer_status["retry_count"].to_i.positive? %>
        retry <%= @mqtt_consumer_status["retry_count"] %>
      <% else %>
        waiting for connection
      <% end %>
    </div>
  </div>
  <% lora_receiver_tone =
      case @summary[:lora_receiver_status]
      when "connected" then "metric-ok"
      when "starting", "degraded" then "metric-warn"
      when "stopped", "missing", "invalid", "stale" then "metric-alert"
      else ""
      end %>
  <div class="card metric-card <%= lora_receiver_tone %>">
    <div class="metric-label">LoRa Gateway</div>
    <div class="metric-value"><%= @summary[:lora_receiver_status].to_s.humanize %></div>
    <div class="muted">
      <% if @lora_receiver_status["status"] == "connected" %>
        serial and MQTT connected
      <% elsif @lora_receiver_status["status"] == "disabled" %>
        LoRa is disabled
      <% elsif @lora_receiver_status["status"] == "starting" %>
        receiver is starting
      <% elsif @lora_receiver_status["status"] == "degraded" %>
        serial or MQTT needs attention
      <% elsif @lora_receiver_status["status"] == "stopped" %>
        receiver stopped
      <% elsif @lora_receiver_status["status"].in?(%w[missing invalid stale]) %>
        status needs attention
      <% else %>
        not reporting yet
      <% end %>
    </div>
  </div>
  <div class="card metric-card <%= @summary[:open_faults] > 0 ? "metric-alert" : "metric-ok" %>">
    <div class="metric-label">Open Faults</div>
    <div class="metric-value"><%= @summary[:open_faults] %></div>
    <div class="muted">unresolved zone faults</div>
  </div>
</div>

<% if @lora_receiver_status["enabled"] != false %>
  <% lora_counters = @lora_receiver_status["counters"] || {} %>
  <section class="card zone-section">
    <div class="zone-section-header">
      <h3>LoRa Gateway Details</h3>
      <div class="muted">Runtime status from the Pi gateway receiver service.</div>
    </div>

    <div class="wizard-facts">
      <div class="wizard-fact"><span>Status</span><strong><%= @lora_receiver_status["status"].to_s.humanize.presence || "Unknown" %></strong></div>
      <div class="wizard-fact"><span>Serial</span><strong><%= @lora_receiver_status.key?("serial_connected") ? (@lora_receiver_status["serial_connected"] ? "Connected" : "Disconnected") : "Unknown" %></strong></div>
      <div class="wizard-fact"><span>MQTT</span><strong><%= @lora_receiver_status.key?("mqtt_connected") ? (@lora_receiver_status["mqtt_connected"] ? "Connected" : "Disconnected") : "Unknown" %></strong></div>
      <div class="wizard-fact"><span>Serial Port</span><strong><%= @lora_receiver_status["serial_port"].presence || "—" %></strong></div>
      <div class="wizard-fact"><span>Updated</span><strong><%= @lora_receiver_status["updated_at"].presence || "—" %></strong></div>
      <div class="wizard-fact"><span>Last Frame</span><strong><%= @lora_receiver_status["last_frame_published_at"].presence || "—" %></strong></div>
      <div class="wizard-fact"><span>Last Command</span><strong><%= @lora_receiver_status["last_command_routed_at"].presence || @lora_receiver_status["last_command_received_at"].presence || "—" %></strong></div>
      <div class="wizard-fact"><span>Last Error</span><strong><%= @lora_receiver_status["last_error"].presence || "None" %></strong></div>
      <div class="wizard-fact"><span>Frames Published</span><strong><%= lora_counters["frames_published"] || 0 %></strong></div>
      <div class="wizard-fact"><span>Frames Dropped</span><strong><%= lora_counters["frames_dropped"] || 0 %></strong></div>
      <div class="wizard-fact"><span>Commands Routed</span><strong><%= lora_counters["lora_commands_routed"] || 0 %></strong></div>
      <div class="wizard-fact"><span>Commands Dropped</span><strong><%= lora_counters["lora_commands_dropped"] || 0 %></strong></div>
    </div>
  </section>
<% end %>

<% active_health_tab = params[:health_tab].presence_in(%w[notifications recent-activity nodes recent-faults]) || "notifications" %>

<div class="zone-show-layout health-show-layout">
  <input type="radio" name="health-section" id="health-nav-attention" class="zone-nav-toggle" <%= "checked" if active_health_tab == "notifications" %>>
  <input type="radio" name="health-section" id="health-nav-activity" class="zone-nav-toggle" <%= "checked" if active_health_tab == "recent-activity" %>>
  <input type="radio" name="health-section" id="health-nav-nodes" class="zone-nav-toggle" <%= "checked" if active_health_tab == "nodes" %>>
  <input type="radio" name="health-section" id="health-nav-faults" class="zone-nav-toggle" <%= "checked" if active_health_tab == "recent-faults" %>>

  <aside class="card zone-side-nav">
    <h3>Navigate</h3>
    <nav class="zone-side-nav-links" aria-label="Health sections">
      <label class="zone-side-nav-link" for="health-nav-attention">Notifications</label>
      <label class="zone-side-nav-link" for="health-nav-activity">Recent Activity</label>
      <label class="zone-side-nav-link" for="health-nav-nodes">Nodes</label>
      <label class="zone-side-nav-link" for="health-nav-faults">Recent Faults</label>
    </nav>
  </aside>

  <div class="zone-show-content">
    <section class="card zone-section health-panel health-panel-attention">
      <div class="zone-section-header">
        <h3>Notifications</h3>
        <div class="muted">Current system-wide warnings and failures that need review.</div>
      </div>

      <% if @attention_items.any? %>
        <div class="attention-list">
          <% @attention_items.each do |item| %>
            <% guidance = health_notification_guidance(item) %>
            <% attention_classes = "attention-item #{item[:tone] == "warn" ? "metric-warn" : "metric-alert"}" %>
            <% if item[:label] == "Open Faults" %>
              <label class="<%= "#{attention_classes} attention-link" %>" for="health-nav-faults">
                <div class="attention-label"><%= item[:label] %></div>
                <div><%= item[:detail] %></div>
                <%= render "shared/issue_guidance",
                           summary: "Description and fix",
                           description_label: "Description",
                           description: guidance[:description],
                           fix_label: "Suggested fix",
                           fix: guidance[:fix] %>
              </label>
            <% else %>
              <div class="<%= attention_classes %>">
                <div class="attention-label"><%= item[:label] %></div>
                <div><%= item[:detail] %></div>
                <%= render "shared/issue_guidance",
                           summary: "Description and fix",
                           description_label: "Description",
                           description: guidance[:description],
                           fix_label: "Suggested fix",
                           fix: guidance[:fix] %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="muted">No active system attention items.</p>
      <% end %>
    </section>

    <section class="card zone-section health-panel health-panel-activity">
      <div class="zone-section-header">
        <h3>Recent Activity</h3>
        <div class="muted">Latest readings, actuator updates, and config acknowledged events.</div>
      </div>

      <% if @recent_activity.any? %>
        <div class="activity-strip">
          <% @recent_activity.each do |item| %>
            <% activity_tone = case item[:label]
                               when "Actuator" then "warn"
                               when "Config Acknowledged" then "ok"
                               else "stale"
                               end %>
            <div class="activity-item">
              <div class="health-pill <%= activity_tone %>"><%= item[:label] %></div>
              <div><%= item[:detail] %></div>
              <div class="muted"><%= time_ago_in_words(item[:at]) %> ago</div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="muted">No recent activity.</p>
      <% end %>
    </section>

    <section class="card zone-section health-panel health-panel-nodes">
      <div class="zone-section-header">
        <h3>Nodes</h3>
        <div class="muted">Assignment state, freshness, config sync, and direct navigation to each node.</div>
      </div>

      <%= render "nodes/nodes_table",
                 nodes: @nodes,
                 latest_readings: @latest_readings,
                 latest_actuator_statuses: @latest_actuator_statuses,
                 return_to: health_path(health_tab: "nodes") %>
    </section>

    <section class="card zone-section health-panel health-panel-faults">
      <div class="zone-section-header">
        <h3>Recent Faults</h3>
        <div class="muted">Most recent unresolved or historical fault records across all zones.</div>
      </div>

      <% if @recent_faults.any? %>
        <div class="attention-list">
          <% @recent_faults.each do |fault| %>
            <% guidance = fault_guidance(fault) %>
            <div class="attention-item attention-warn">
              <div class="attention-label">
                <strong><%= fault.zone.present? ? (fault.zone.name.presence || fault.zone.zone_id) : "System" %></strong>
                <% if fault.node_id.present? %>
                  <span><%= fault.node&.display_name || fault.node_id %></span>
                <% end %>
                <span class="health-pill warn"><%= fault.fault_code %></span>
                <span class="muted"><%= time_ago_in_words(fault.recorded_at) %> ago</span>
              </div>
              <div><%= fault.detail.presence || "No additional detail was provided." %></div>
              <%= render "shared/issue_guidance",
                         summary: "Description and fix",
                         description_label: "Description",
                         description: guidance[:description],
                         fix_label: "Suggested fix",
                         fix: guidance[:fix] %>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="muted">No recent faults.</p>
      <% end %>
    </section>
  </div>
</div>
