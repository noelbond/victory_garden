<%= form_with model: @zone, data: { turbo_frame: "_top" } do |f| %>
  <% if @zone.errors.any? %>
    <div class="card" style="margin-bottom: 16px;">
      <h3>Zone could not be saved</h3>
      <ul class="list">
        <% @zone.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="field">
      <%= f.label :name, "Zone Name" %>
      <%= f.text_field :name, placeholder: "Greenhouse Zone 1" %>
    </div>

    <div class="field">
      <%= f.label :active, "Active" %>
      <%= f.select :active, [[ "Yes", true ], [ "No", false ]] %>
    </div>

    <div class="field">
      <%= f.label :publish_interval_ms, "Reading Frequency" %>
      <%= f.select :publish_interval_ms,
                   options_for_select(@reading_frequency_options, @zone.publish_interval_ms || 3_600_000) %>
    </div>

  </div>

  <div style="margin-top: 16px;">
    <%= f.submit class: "btn" %>
    <%= link_to "Cancel", (@zone.persisted? ? zone_path(@zone) : zones_path), class: "btn light", data: { turbo_frame: (@zone.persisted? ? "zone_workspace" : "_top") } %>
  </div>
  <div class="section-header">
    <h2>Assign Nodes</h2>
    <p class="muted">
      <% if @zone.persisted? %>
        Nodes are provisioned with their Zone and remain attached to it.
      <% else %>
        Sensor Nodes are created by Zone provisioning after the Zone is saved.
      <% end %>
    </p>
  </div>

  <div class="card">
    <% if @assignable_nodes.any? %>
      <div class="reading-columns-grid">
        <% @assignable_nodes.each do |node| %>
          <label class="reading-column-option zone-node-option">
            <%= check_box_tag "node_ids[]", node.id, @zone.persisted? ? node.zone_id == @zone.id : false %>
            <span>
              <strong><%= node.node_id %></strong>
              <span class="muted">Reported Zone ID: <%= node.reported_zone_id.presence || "—" %></span>
            </span>
          </label>
        <% end %>
      </div>
    <% else %>
      <p class="muted">No assignable nodes are currently available.</p>
    <% end %>
  </div>
<% end %>
