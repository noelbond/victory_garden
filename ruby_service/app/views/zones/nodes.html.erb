<div class="zone-show-layout">
  <%= render "side_nav_fallback", zone: @zone %>

  <div class="zone-show-content">
    <%= turbo_frame_tag "zone_workspace", data: { zone_workspace_target: "nodes" } do %>
      <div class="page-header">
        <div>
          <h1 class="page-title"><%= @zone.name.presence || @zone.zone_id %> Nodes</h1>
          <div class="muted">
            <%= @assigned_nodes.count %> assigned node<%= "s" unless @assigned_nodes.count == 1 %> for this zone.
          </div>
        </div>
        <div class="dashboard-actions">
          <%= link_to "Back to Zone", zone_path(@zone), class: "btn light", data: { turbo_frame: "_top" } %>
          <%= link_to "All Nodes", nodes_path, class: "btn light", data: { turbo_frame: "_top" } %>
        </div>
      </div>

      <%= render "nodes/nodes_table",
                 nodes: @assigned_nodes,
                 latest_readings: @latest_readings_by_node_id,
                 latest_actuator_statuses: @latest_actuator_statuses_by_node_id,
                 return_to: zone_nodes_path(@zone),
                 empty_message: "This zone does not have any assigned sensor nodes yet." %>
    <% end %>
  </div>
</div>
